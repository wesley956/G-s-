{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nilson gás e Água",
  "version": "0.2.0",
  "identifier": "br.gs.deposito",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nilson gás e Água",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Gestão offline de depósito",
    "longDescription": "Sistema desktop offline para vendas, estoque, caixa e clientes.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows-installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "84C1B530-7082-5203-85C6-3BAB0D9EE08A"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:deposito.db"
      ]
    }
  }
}
