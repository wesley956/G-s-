{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-s- Gestão de Depósito",
  "version": "0.1.0",
  "identifier": "br.gs.deposito",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "G-s- Gestão de Depósito",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Gestão offline de depósito",
    "longDescription": "Sistema desktop offline para vendas, estoque, caixa e clientes."
  }
}
